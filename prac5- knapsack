#include <stdio.h>

int max(int a, int b)
{
    return a > b ? a : b;
}

int main()
{
    int n, W, i, w;
    int wt[10], pr[10], p[10][20];

    printf("Enter number of items: ");
    scanf("%d", &n);

    printf("Enter weights:\n");
    for(i = 1; i <= n; i++)
        scanf("%d", &wt[i]);

    printf("Enter profits:\n");
    for(i = 1; i <= n; i++)
        scanf("%d", &pr[i]);

    printf("Enter capacity: ");
    scanf("%d", &W);

    for(w = 0; w <= W; w++)
        p[0][w] = 0;

    for(i = 1; i <= n; i++)
        for(w = 0; w <= W; w++)
            if(wt[i] <= w)
                p[i][w] = max(p[i-1][w],
                    p[i-1][w-wt[i]] + pr[i]);
            else
                p[i][w] = p[i-1][w];

    printf("Maximum Profit = %d", p[n][W]);

    return 0;
}