#include <stdio.h>

int main()
{
    int a[10][10], n, i, j, k, reachable;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix (0 for no edge):\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for(k = 0; k < n; k++)
        for(i = 0; i < n; i++)
            for(j = 0; j < n; j++)
                if((i == k || a[i][k] != 0) &&
                   (k == j || a[k][j] != 0))
                {
                    reachable = a[i][k] + a[k][j];

                    if(i == k) reachable = a[k][j];
                    if(k == j) reachable = a[i][k];

                    if(i != j && a[i][j] == 0)
                        a[i][j] = reachable;
                    else if(reachable != 0 &&
                            (a[i][j] == 0 || reachable < a[i][j]))
                        a[i][j] = reachable;
                }

    printf("Shortest distance matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
            printf("%d ", a[i][j]);
        printf("\n");
    }

    return 0;
}
