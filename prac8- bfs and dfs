#include <stdio.h>

int a[10][10], visited[10], n;

void dfs(int v)
{
    int i;
    printf("%d ", v);
    visited[v] = 1;

    for(i = 0; i < n; i++)
        if(a[v][i] && !visited[i])
            dfs(i);
}

void bfs(int v)
{
    int q[10], front = 0, rear = 0, i;
    for(i = 0; i < n; i++) visited[i] = 0;

    q[rear++] = v;
    visited[v] = 1;

    while(front < rear)
    {
        v = q[front++];
        printf("%d ", v);

        for(i = 0; i < n; i++)
            if(a[v][i] && !visited[i])
            {
                q[rear++] = i;
                visited[i] = 1;
            }
    }
}

int main()
{
    int i, j;
    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    printf("DFS: ");
    dfs(0);

    printf("\nBFS: ");
    bfs(0);
    return 0;
}