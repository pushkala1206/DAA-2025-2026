#include <stdio.h>

int a[10][10], n, mincost;
int used[10], first = 1;

void tsp(int city, int count, int cost)
{
    int i;

    if(count == n)
    {
        if(a[city][0] > 0)
        {
            cost += a[city][0];

            if(first || cost < mincost)
            {
                mincost = cost;
                first = 0;
            }
        }
        return;
    }

    for(i = 1; i < n; i++)
    {
        if(!used[i] && a[city][i] > 0)
        {
            used[i] = 1;
            tsp(i, count + 1, cost + a[city][i]);
            used[i] = 0;
        }
    }
}
int main()
{
    int i, j;

    printf("Enter number of cities: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    used[0] = 1;
    tsp(0, 1, 0);

    if(first)
        printf("No tour possible");
    else
        printf("Minimum cost = %d", mincost);

    return 0;
}